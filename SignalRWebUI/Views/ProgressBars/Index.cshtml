@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    if (ViewData["Title"]?.ToString() == "Index")
    {
        ViewBag.ActiveProgress = "active";
    }
    else
    {
        ViewBag.ActiveProgress = "";
    }
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<div class="content">
    <div class="container-fluid">
        <script type="text/javascript">
            $(document).ready(()=>{

                var connection=new signalR.HubConnectionBuilder().withUrl("https://localhost:44321/SignalRHub").build();
                $("#connstatus").text(connection.state);
                connection.start().then(()=>{
                    $("#connstatus").text(connection.state);
                    setInterval(()=>{
                        connection.invoke("SendProgress");

                    },1000);
                }).catch((err)=>{console.log(err)});

                connection.on("ReceiveTotalMoneyCaseAmount",(value)=>{
                    $("#totalmoneycaseamount").text(value);
                });

                connection.on("ReceiveActiveOrderCount",(value2)=>{
                    $("#activeorder").text(value2);
                });

                connection.on("ReceiveMenuTableCount",(value3)=>{
                    $("#tablecount").text(value3);
                });

                connection.on("ReceiveMenuTableCount",(value4)=>{
                    $("#totalTableCountProgress").empty();
                    $("#totalTableCountProgress").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Toplam Masa Sayısı</span>
                           <span class="text-muted fw-bold"> ${value4}/100</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width:
                            ${value4}%" aria-valuenow="${value4}" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip"
                            data-placement="top" title="${value4}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveProductPriceAvg",(value5)=>{
                    const width = (value5 / 150) * 100;

                    $("#priceavg").empty();
                    $("#priceavg").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Fiyat</span>
                           <span class="text-muted fw-bold"> ${value5}/150</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value5}" aria-valuemin="0" aria-valuemax="100"
                            data-toggle="tooltip" data-placement="top" title="${value5}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceByHamburger",(value6)=>{
                    const width = (value6 / 200) * 100;

                    $("#priceavghamburger").empty();
                    $("#priceavghamburger").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Hamburger Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value6}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value6}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value6}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveDrink",(value7)=>{
                    const width = (value7 / 15) * 100;

                    $("#drink").empty();
                    $("#drink").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">İçecek Sayısı</span>
                           <span class="text-muted fw-bold"> ${value7}/15</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value7}" aria-valuemin="0" aria-valuemax="15"
                            data-toggle="tooltip" data-placement="top" title="${value7}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveTotalOrderCount",(value8)=>{

                    $("#totalorder").empty();
                    $("#totalorder").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Toplam Sipariş Sayısı</span>
                           <span class="text-muted fw-bold"> ${value8}/100</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-secondary" role="progressbar" style="width:
                            ${value8}%" aria-valuenow="${value8}" aria-valuemin="0" aria-valuemax="100"
                            data-toggle="tooltip" data-placement="top" title="${value8}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceByPizza",(value9)=>{
                    const width = (value9 / 200) * 100;

                    $("#priceavgpizza").empty();
                    $("#priceavgpizza").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Pizza Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value9}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-gradient" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value9}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value9}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceByPasta",(value10)=>{
                    const width = (value10 / 200) * 100;

                    $("#priceavgpasta").empty();
                    $("#priceavgpasta").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Makarna Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value10}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-dark" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value10}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value10}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceByDessert",(value11)=>{
                    const width = (value11 / 200) * 100;

                    $("#priceavgdessert").empty();
                    $("#priceavgdessert").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Tatlı Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value11}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value11}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value11}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceByFrying",(value12)=>{
                    const width = (value12 / 200) * 100;

                    $("#priceavgfrying").empty();
                    $("#priceavgfrying").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Kızartma Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value12}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value12}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value12}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceByDrink",(value13)=>{
                    const width = (value13 / 200) * 100;

                    $("#priceavgdrink").empty();
                    $("#priceavgdrink").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama İçecek Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value13}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value13}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value13}%"></div>
                         </div>
                    `);
                });

                connection.on("ReceiveAvgPriceBySalad",(value14)=>{
                    const width = (value14 / 200) * 100;

                    $("#priceavgsalad").empty();
                    $("#priceavgsalad").append(`
                         <div class="d-flex justify-content-between mb-1">
                           <span class="text-muted">Ortalama Salata Fiyatı</span>
                           <span class="text-muted fw-bold"> ${value14}/200</span>
                         </div>
                         <div class="progress mb-2" style="height: 7px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width:
                            ${width}%" aria-valuenow="${value14}" aria-valuemin="0" aria-valuemax="200"
                            data-toggle="tooltip" data-placement="top" title="${value14}%"></div>
                         </div>
                    `);
                });


                connection.on("ReceiveCategoryCount",(value15)=>{
                    $("#categorycount").text(value15);
                });

                connection.on("ReceiveProductCount",(value16)=>{
                    $("#productcount").text(value16);
                });

                connection.on("ReceiveBookingCount",(value17)=>{
                    $("#bookingcount").text(value17);
                });

                connection.on("ReceiveTotalOrderCount",(value18)=>{
                    $("#totaloredercount").text(value18);
                });
                
                connection.on("ReceiveLastOrderPrice",(value19)=>{
                    $("#lastorderprice").text(value19);
                });

                 connection.on("ReceiveTodayTotalPrice",(value20)=>{
                    $("#todaytotalprice").text(value20);
                });
            });
        </script>

        <h4 class="page-title">Anlık İstatistik Bilgileri ve Grafikleri</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="row row-card-no-pd">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <br />
                                <p class="fw-bold mt-1">Kasadaki Toplam Tutar</p>
                                <br />
                                <h4 id="totalmoneycaseamount"><b></b></h4>
                                <br /><hr /><br />
                                <p class="fw-bold mt-1">Bugünkü Kazanç</p>
                                <br />
                                <h4 id="todaytotalprice"><b></b></h4>
                                <br /><hr /><br />
                                <p class="fw-bold mt-1">Son Sipariş Tutarı</p>
                                <br />
                                <h4 id="lastorderprice"><b></b></h4>

                                <a href="/Order/CreateOrder/" class="btn btn-primary btn-full text-left mt-3 mb-3"><i class="la la-plus"></i> Yeni Sipariş</a>
                            </div>
                            <div class="card-footer">
                                <ul class="nav">
                                    <li class="nav-item"><a class="btn btn-default btn-link" href="/Order/Index/"><i class="la la-history"></i> Siparişler</a></li>
                                    <li class="nav-item ml-auto"><a class="btn btn-default btn-link" href="/ProgressBars/Index/"><i class="la la-refresh"></i> Sayfayı Yenile</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card">
                            <div class="card-body">
                                <div class="progress-card" id="drink"></div>
                                <div class="progress-card" id="totalTableCountProgress"></div>
                                <div class="progress-card" id="totalorder"></div>
                                <div class="progress-card" id="priceavg"></div>
                                <div class="progress-card" id="priceavghamburger"></div>
                                <div class="progress-card" id="priceavgpizza"></div>
                                <div class="progress-card" id="priceavgpasta"></div>
                                <div class="progress-card" id="priceavgdessert"></div>
                                <div class="progress-card" id="priceavgfrying"></div>
                                <div class="progress-card" id="priceavgdrink"></div>
                                <div class="progress-card" id="priceavgsalad"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-stats">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center icon-warning">
                                            <i class="la la-hourglass-half text-warning"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Aktif Siparişler</p>
                                            <h4 class="card-title" id="activeorder"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-heart-o text-danger"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Masa Sayısı</p>
                                            <h4 class="card-title" id="tablecount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-puzzle-piece  text-success"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Kategori Sayısı</p>
                                            <h4 class="card-title" id="categorycount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-birthday-cake text-secondary"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Ürün Sayısı</p>
                                            <h4 class="card-title" id="productcount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-anchor text-dark"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Rezervasyon Sayısı</p>
                                            <h4 class="card-title" id="bookingcount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-history text-info"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Toplam Sipariş Sayısı</p>
                                            <h4 class="card-title" id="totaloredercount"></h4>
                                        </div>
                                    </div>
                                </div>
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
