﻿@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    if (ViewData["Title"]?.ToString() == "Index")
    {
        ViewBag.ActiveQR = "active";
    }
    else
    {
        ViewBag.ActiveQR = "";
    }
}

<div class="content">
    <div class="container-fluid text-center">
        <h4 class="page-title">QR Kod Oluşturma</h4>
        <div class="row">
            <div class="col-md-12">
                <form method="post" asp-action="Index" asp-controller="QRCode" class="text-center">
                    <input type="text" name="value" placeholder="Masa Adını Yazınız." />
                    <input type="submit" value="QR Kod Oluştur" class="btn btn-warning" />
                    <br /><br />
                    @if (ViewBag.QrCodeImage != null)
                    {
                        <img src="@ViewBag.QrCodeImage" alt="" style="width:400px;height:400px" />
                    }
                </form>
            </div>
        </div>
    </div>
</div>