@model List<ResultProductWithCategory>

@{
    var filteredProducts = Model.Take(9).ToList(); // İlk 9 ürünü al
    var filteredCategories = filteredProducts.Select(x => x.CategoryName).Distinct(); // Sadece o ürünlerin kategorilerini al
}

<section class="food_section layout_padding-bottom">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>
                Menümüz
            </h2>
        </div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">Tümü</li>
            @foreach (var category in filteredCategories)
            {
                <li data-filter=".@category.Replace(" ", "-")">@category</li>
            }
        </ul>

        <div class="filters-content">
            <div class="row grid">
                @foreach (var item in filteredProducts)
                {
                    <div class="col-sm-6 col-lg-4 all @item.CategoryName.Replace(" ", "-")">
                        <div class="box">
                            <div>
                                <div class="img-box">
                                    <img src="@item.ImageUrl" alt="">
                                </div>
                                <div class="detail-box">
                                    <h5>
                                        @item.ProductName
                                    </h5>
                                    <p>
                                        @item.Description
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="btn-box">
            <a href="/Menu/Index/">
                Daha Fazlasını Gör
            </a>
        </div>
    </div>
</section>
