@model List<ResultProductWithCategory>

@{
    var filteredProducts = Model.Take(9).ToList(); // İlk 9 ürünü al
    var filteredCategories = filteredProducts.Select(x => x.CategoryName).Distinct(); // Sadece o ürünlerin kategorilerini al
}

<section class="food_section layout_padding-bottom">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>
                Menümüz
            </h2>
        </div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">Tümü</li>
            @foreach (var category in filteredCategories)
            {
                <li data-filter=".@category.Replace(" ", "-")">@category</li>
            }
        </ul>

        <div class="filters-content">
            <div class="row grid">
                @foreach (var item in filteredProducts)
                {
                    <div class="col-sm-6 col-lg-4 all @item.CategoryName.Replace(" ", "-")">
                        <div class="box">
                            <div>
                                <div class="img-box">
                                    <img src="@item.ImageUrl" alt="">
                                </div>
                                <div class="detail-box">
                                    <h5>
                                        @item.ProductName
                                    </h5>
                                    <p>
                                        @item.Description
                                    </p>
                                    <div class="options">
                                        <h6>
                                            @item.Price ₺
                                        </h6>
                                        <a href="">
                                            <svg version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 456.029 456.029" style="enable-background:new 0 0 456.029 456.029;" xml:space="preserve">
                                            <g>
                                            <g>
                                            <path d="M345.6,338.862c-29.184,0-53.248,23.552-53.248,53.248c0,29.184,23.552,53.248,53.248,53.248
                         c29.184,0,53.248-23.552,53.248-53.248C398.336,362.926,374.784,338.862,345.6,338.862z" />
                                                        </g>
                                                    </g>
                                                </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="btn-box">
            <a href="/Menu/Index/">
                Daha Fazlasını Gör
            </a>
        </div>
    </div>
</section>
