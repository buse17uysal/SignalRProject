@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>Uysal Restoran Giriş Sayfası</title>
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<link rel="stylesheet" type="text/css" href="~/colorlib-regform-32/css/nunito-font.css">
	<link rel="stylesheet" href="~/colorlib-regform-32/css/style.css" />
</head>
<body class="form-v6">
	<div class="page-content">
		<div class="form-v6-content">
			<div class="form-left">
				<img src="~/colorlib-regform-32/images/fastfood.png" alt="form" style="width:484px; height:584px">
			</div>
			<form class="form-detail" action="#" method="post">
				<h2>Giriş Formu</h2>
				<div class="form-row">
					<input type="text" id="user-name" class="input-text" placeholder="Kullanıcı Adınız" required asp-for="UserName">
				</div>
				<div class="form-row">
					<input type="password" id="password" class="input-text" placeholder="Şifreniz" asp-for="Password" required>
				</div>
				<div class="form-row-last">
					<input type="submit" name="register" class="register" value="Giriş Yap">
				</div>
				<br /><br />
				<div class="form-row-last">
					<a href="/Register/Index/" class="register" style="text-decoration: none; display: inline-block; padding: 10px 20px; background-color: #f85a40; color: white; border-radius: 5px;">Kayıt Yap</a>
				</div>
			</form>
		</div>
	</div>
</body>
</html>

@* arkaplan rengi değişmiyorsa ctrl+shift+r tarayıcıda					 *@